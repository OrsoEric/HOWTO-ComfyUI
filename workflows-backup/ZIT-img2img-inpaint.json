model","name":"model","type":"MODEL","link":122},{"localized_name":"shift","name":"shift","type":"FLOAT","widget":{"name":"shift"},"link":null}],"outputs":[{"localized_name":"MODEL","name":"MODEL","type":"MODEL","slot_index":0,"links":[123]}],"properties":{"cnr_id":"comfy-core","ver":"0.3.64","Node name for S&R":"ModelSamplingAuraFlow","enableTabs":false,"tabWidth":65,"tabXOffset":10,"hasSecondTab":false,"secondTabText":"Send Back","secondTabOffset":80,"secondTabWidth":65},"widgets_values":[3],"color":"#323","bgcolor":"#535"},{"id":91,"type":"Note","pos":[19.114526429609004,1270.5066837119725],"size":[497.11921481187824,154.2654437201095],"flags":{},"order":4,"mode":0,"inputs":[],"outputs":[],"properties":{},"widgets_values":["Diffusion Models have an high dimensional latent concept space that encodes\nthe latent pixel distribution of everything the model knows.\nCLIP task is to find the coordinates of the concept that you want to diffuse\ninside that latent concept space, so the model can diffuse that distribution\nin the latent pixel space.\n\nQwen 3 4B is a strong LLM, it's using its embeddings to drive the diffusion model, that is STRONK.\n\nThis approach is stronger than HiDream using FOUR text ecoders.\n\n"],"color":"#432","bgcolor":"#653"},{"id":87,"type":"Note","pos":[663.2057739882046,1410.1368106650975],"size":[476.9273681640625,150.90830993652344],"flags":{},"order":5,"mode":0,"inputs":[],"outputs":[],"properties":{},"widgets_values":["Diffusion Models don't work directly with pixels. To save space, they use a smaller latent pixel space that reduces the size of the matricies involved.\nVAE's job is to turn RGB pixels into latent pixels (encode), and turn latent pixels into RGB pixels (decode).\n\nA fast low accuracy version of the VAE decode is used to show the progress in each step of the diffusion model in the KSampler\n\nThis is just Flux VAE as far as I can tell"],"color":"#332922","bgcolor":"#593930"},{"id":126,"type":"Reroute","pos":[-168.4369042263