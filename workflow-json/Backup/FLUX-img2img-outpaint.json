t space that encodes\nthe latent pixel distribution of everything the model knows.\nCLIP task is to find the coordinates of the concept that you want to diffuse\ninside that latent concept space, so the model can diffuse that distribution\nin the latent pixel space.\n\nFlux has a CLIP and a Text Encoder.\n\nFlux CLIP L:\nhttps://huggingface.co/black-forest-labs/FLUX.1-dev/blob/main/text_encoder/model.safetensors\n\nFlux Text Encoder (FP8):\nhttps://huggingface.co/Aitrepreneur/FLX/blob/main/umt5_xxl_fp8_e4m3fn_scaled.safetensors\n\nFlux Text Encoder (FP16):\nhttps://huggingface.co/Aitrepreneur/FLX/blob/main/t5xxl_fp16.safetensors"],"color":"#432","bgcolor":"#653"},{"id":88,"type":"Reroute","pos":[-737.1799926757812,-178.04391479492188],"size":[75,26],"flags":{},"order":29,"mode":0,"inputs":[{"name":"","type":"*","link":134}],"outputs":[{"name":"VAE","type":"VAE","links":[129,171]}],"title":"CLIP","properties":{"showOutputText":true,"horizontal":false},"color":"#332922","bgcolor":"#593930"},{"id":33,"type":"CLIPTextEncode","pos":[-1216.5263671875,111.54428100585938],"size":[421.4798583984375,88],"flags":{"collapsed":true},"order":43,"mode":0,"inputs":[{"localized_name":"clip","name":"clip","type":"CLIP","link":69},{"localized_name":"text","name":"text","type":"STRING","widget":{"name":"text"},"link":null}],"outputs":[{"localized_name":"CONDITIONING","name":"CONDITIONING","type":"CONDITIONING","slot_index":0,"links":[273]}],"title":"CLIP Text Encode (Negative Prompt)","properties":{"cnr_id":"comfy-core","ver":"0.3.26","Node name for S&R":"CLIPTextEncode"},"widgets_values":[""],"color":"#322","bgcolor":"#533"},{"id":6,"type":"CLIPTextEncode","pos":[-1215.34375,66.33137512207031],"size":[443.9068908691406,233.11822509765625],"flags":{"collapsed":true},"order":42,"mode":0,"inputs":[{"localized_name":"clip","name":"clip","type":"CLIP","link":68},{"localized_name":"text","name":"text","type":"STRING","widget":{"name":"text"},"link":167}],"outputs":[{"localized_name":"CONDIT